*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
.jac-version text eol=lf
# Preserve the recovered source's CRLF while checking real whitespace mistakes.
*.jac whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.toml whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Reviewed proof inputs retain the exact hashed bytes and original line endings.
runtime-proof/inputs/** -text
runtime-proof/package-inputs/** -text
runtime-proof/runtime-direct-use-inputs-v1.json -text
runtime-proof/ui-dependency-inputs/** -text
runtime-proof/native-inputs/native-suite-v5/** -text
# Frozen originals retain their hashed CRLF and existing terminal blank line.
runtime-proof/native-inputs/native-suite-v5/export-emergency-checkpoint.py whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
runtime-proof/native-inputs/native-suite-v5/run-kali-native-gate.py whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
